  "info": {
    "title": "RAG_all API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/__maintenance/contracts/{model_name}": {
      "post": {
        "description": "Isolated DTO validation only; requires an explicit in-memory test token in X-RAG-Contract-Test. Disabled by default. No business authorization, database access, provider calls, or operation execution. Keep this path off private/public production gateways. Response-envelope request_id is replaced by a fresh server ID. Only the five C2 response models are accepted; helper DTOs are schema components only. OperationResponse models GET-state projection semantics; this POST probe does not register a business GET operation endpoint.",
        "operationId": "contract_probe___maintenance_contracts__model_name__post",
        "parameters": [
          {
            "in": "path",
            "name": "model_name",
            "required": true,
            "schema": {
              "enum": [
                "AcceptedResponse",
                "CompletedResponse",
                "FailedResponse",
                "OperationResponse",
                "RetrievalResponse"
              ],
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/AcceptedResponse-Input"
                  },
                  {
                    "$ref": "#/components/schemas/CompletedResponse-Input"
                  },
                  {
                    "$ref": "#/components/schemas/FailedResponse-Input"
                  },
                  {
                    "$ref": "#/components/schemas/OperationResponse-Input"
                  },
                  {
                    "$ref": "#/components/schemas/RetrievalResponse-Input"
                  }
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/CompletedResponse-Output"
                    },
                    {
                      "$ref": "#/components/schemas/OperationResponse-Output"
                    },
                    {
                      "$ref": "#/components/schemas/RetrievalResponse-Output"
                    }
                  ]
                }
              }
            },
            "description": "Validated fixture DTO, including operation state projection."
          },
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcceptedResponse-Output"
                }
              }
            },
            "description": "Validated AcceptedResponse fixture; no operation is created."
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FailedResponse-Output"
                }
              }
            },
            "description": "Finite private error or validated FailedResponse fixture."
          }
        },
        "summary": "Contract Probe",
        "tags": [
          "isolated-contract-fixtures"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    }
  }
}
