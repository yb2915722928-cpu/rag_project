{
  "$id": "https://rag.local/contracts/schemas/answer.v1/Summary.serialization.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "fact_ids": {
      "items": {
        "pattern": "^f(?:[1-9]|1[0-6])$",
        "type": "string"
      },
      "maxItems": 16,
      "title": "Fact Ids",
      "type": "array"
    },
    "text": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
    "text",
    "fact_ids"
  ],
  "title": "Summary",
  "type": "object"
}
