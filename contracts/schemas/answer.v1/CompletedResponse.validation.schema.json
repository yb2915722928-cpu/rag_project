{
  "$defs": {
    "ConflictSides": {
      "additionalProperties": false,
      "properties": {
        "side_a": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Side A",
          "type": "array"
        },
        "side_b": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Side B",
          "type": "array"
        }
      },
      "required": [
        "side_a",
        "side_b"
      ],
      "title": "ConflictSides",
      "type": "object"
    },
    "EvidenceBlock": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Chunk Id",
          "type": "string"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "evidence_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "excerpt": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "evidence_id",
        "chunk_id",
        "excerpt",
        "start",
        "end"
      ],
      "title": "EvidenceBlock",
      "type": "object"
    },
    "Fact": {
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "maxLength": 256,
          "title": "Applicability",
          "type": "string"
        },
        "conflict_sides": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConflictSides"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_ids": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "process",
            "material",
            "condition",
            "owner",
            "cause",
            "check",
            "step",
            "parameter",
            "limitation"
          ],
          "title": "Kind",
          "type": "string"
        },
        "order": {
          "maximum": 16,
          "minimum": 1,
          "title": "Order",
          "type": "integer"
        },
        "quantity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "order",
        "text",
        "applicability",
        "evidence_ids",
        "quantity",
        "conflict_sides"
      ],
      "title": "Fact",
      "type": "object"
    },
    "Gap": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "enum": [
            "process",
            "material",
            "condition",
            "owner",
            "cause",
            "check",
            "step",
            "parameter",
            "limitation",
            "object_identity",
            "version",
            "environment",
            "log_context",
            "evidence",
            "source_locator"
          ],
          "title": "Field",
          "type": "string"
        },
        "text": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "field",
        "text"
      ],
      "title": "Gap",
      "type": "object"
    },
    "Outcome": {
      "enum": [
        "answered",
        "insufficient",
        "clarify",
        "conflict"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "Quantity": {
      "additionalProperties": false,
      "properties": {
        "unit": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "value_text": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Value Text",
          "type": "string"
        }
      },
      "required": [
        "value_text",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "Summary": {
      "additionalProperties": false,
      "properties": {
        "fact_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Fact Ids",
          "type": "array"
        },
        "text": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "fact_ids"
      ],
      "title": "Summary",
      "type": "object"
    }
  },
  "$id": "https://rag.local/contracts/schemas/answer.v1/CompletedResponse.validation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accepted_at": {
      "format": "date-time",
      "pattern": "Z$",
      "title": "Accepted At",
      "type": "string"
    },
    "clarifications": {
      "items": {
        "$ref": "#/$defs/Gap"
      },
      "maxItems": 4,
      "title": "Clarifications",
      "type": "array"
    },
    "completed_at": {
      "format": "date-time",
      "pattern": "Z$",
      "title": "Completed At",
      "type": "string"
    },
    "evidence_catalog": {
      "items": {
        "$ref": "#/$defs/EvidenceBlock"
      },
      "maxItems": 5,
      "title": "Evidence Catalog",
      "type": "array"
    },
    "execution_snapshot_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Execution Snapshot Id",
      "type": "string"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/Fact"
      },
      "maxItems": 16,
      "title": "Facts",
      "type": "array"
    },
    "gaps": {
      "items": {
        "$ref": "#/$defs/Gap"
      },
      "maxItems": 8,
      "title": "Gaps",
      "type": "array"
    },
    "operation_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Operation Id",
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/Outcome"
    },
    "replayed": {
      "title": "Replayed",
      "type": "boolean"
    },
    "request_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "answer.v1",
      "default": "answer.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "const": "completed",
      "default": "completed",
      "title": "Status",
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/Summary"
    }
  },
  "required": [
    "outcome",
    "summary",
    "facts",
    "gaps",
    "clarifications",
    "request_id",
    "operation_id",
    "replayed",
    "accepted_at",
    "completed_at",
    "execution_snapshot_id",
    "evidence_catalog"
  ],
  "title": "CompletedResponse",
  "type": "object"
}
