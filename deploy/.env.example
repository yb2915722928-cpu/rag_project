# Example only; none of these values are approved digests or real secrets.
# Copy to an operator-owned .env outside the repository, or export these
# variables in the shell. Never commit real digests/secrets/paths.
# Every *_IMAGE value must be an approved reference with an exact
# linux/amd64 digest: <repository>:<approved-version>@sha256:<64 hex>.
PYTHON_BASE_IMAGE=python:3.12.8-slim-bookworm@sha256:<64-hex>
UV_BASE_IMAGE=ghcr.io/astral-sh/uv:<approved-version>@sha256:<64-hex>
NGINX_BASE_IMAGE=nginx:1.30.6-alpine@sha256:<64-hex>
POSTGRES_IMAGE=<approved-postgres-18.6-pgvector-0.8.7-image>@sha256:<64-hex>

RAG_GATEWAY_BIND=127.0.0.1
RAG_GATEWAY_PORT=8443
RAG_GATEWAY_IMAGE=rag-story-1-1-gateway:local
RAG_API_IMAGE=rag-story-1-1-api:local

RAG_ENVIRONMENT=production
# Container API bind is fixed at 0.0.0.0:8000 in compose.yaml; do not add
# RAG_API_HOST/RAG_API_PORT overrides without changing the gateway upstream,
# health checks, and this delivery record together.
# No password in the DSN; libpq reads the per-service PGPASSFILE secret.
RAG_DATABASE_URL=postgresql+psycopg://rag@postgres:5432/rag
RAG_DATABASE_SCHEMA=public
POSTGRES_DB=rag
POSTGRES_USER=rag

# Verified numeric UID/GID of the PostgreSQL image and its data directory.
RAG_POSTGRES_UID=<verified-pg-uid>
RAG_POSTGRES_GID=<verified-pg-gid>

# Host paths for the project-specific local filesystem volumes.
RAG_PGDATA_ROOT=/opt/rag-story-1-1/postgres
RAG_ASSET_ROOT=/opt/rag-story-1-1/assets
RAG_LOCK_ROOT=/opt/rag-story-1-1/locks
RAG_EPOCH_ROOT=/opt/rag-story-1-1/epoch

# Secret files live outside the repository.
RAG_TLS_CERT_FILE=/opt/rag-story-1-1/secrets/tls-cert.pem
RAG_TLS_KEY_FILE=/opt/rag-story-1-1/secrets/tls-key.pem
RAG_POSTGRES_PASSWORD_FILE=/opt/rag-story-1-1/secrets/postgres-password
RAG_POSTGRES_PGPASS_FILE=/opt/rag-story-1-1/secrets/postgres-pgpass
