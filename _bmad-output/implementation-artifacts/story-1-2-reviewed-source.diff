+class _FakeSocket:
+    def __init__(self, family: int, *, connect_error: BaseException | None = None):
+        self.family = family
+        self.connect_error = connect_error
+        self.connect_calls: list[tuple[str, int]] = []
+        self.timeout = None
+        self.closed = 0
+
+    def settimeout(self, value: float) -> None:
+        self.timeout = value
+
+    def connect(self, address: tuple[str, int]) -> None:
+        self.connect_calls.append(address)
+        if self.connect_error is not None:
+            raise self.connect_error
+
+    def close(self) -> None:
+        self.closed += 1
+
+
+class _FakeWrapped:
+    def __init__(self) -> None:
+        self.sent: list[bytes] = []
+        self.closed = 0
+
+    def sendall(self, data: bytes) -> None:
+        self.sent.append(bytes(data))
+
+    def makefile(self, mode: str):
+        return io.BytesIO(b"")
+
+    def close(self) -> None:
+        self.closed += 1
+
+
+class _FakeContext:
+    def __init__(
+        self,
+        *,
+        check_hostname: bool = True,
+        verify_mode=ssl.CERT_REQUIRED,
+        wrap_error: BaseException | None = None,
+    ) -> None:
+        self.check_hostname = check_hostname
+        self.verify_mode = verify_mode
+        self.wrap_error = wrap_error
+        self.wrap_calls: list[tuple[object, str, bool]] = []
+        self.wrapped = _FakeWrapped()
+
+    def wrap_socket(
+        self,
+        sock,
+        *,
+        server_hostname: str | None = None,
+        do_handshake_on_connect: bool = True,
+    ):
+        self.wrap_calls.append((sock, server_hostname, do_handshake_on_connect))
+        if self.wrap_error is not None:
+            raise self.wrap_error
+        return self.wrapped
+
