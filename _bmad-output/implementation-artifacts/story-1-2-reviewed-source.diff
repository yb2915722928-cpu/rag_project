+    assert decode_frame(frame, 64) == {"type": "ready"}
+    with pytest.raises(ChildSupervisionError):
+        decode_frame(frame[:-1], 64)
+    with pytest.raises(ChildSupervisionError):
+        decode_frame(frame + b"x", 64)
